{
  "crons": [
    {
      "path": "/api/cron/facturacion",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/daily",
      "schedule": "0 12 * * *"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
