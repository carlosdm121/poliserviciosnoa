{
  "crons": [
    {
      "path": "/api/cron/facturacion",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/daily",
      "schedule": "0 12 * * *"
    }
  ],
    "redirects": [
      {
        "source": "/:path*",
        "has": [
          {
            "type": "host",
            "value": "www.poliserviciosnoa.com"
          }
        ],
        "destination": "https://poliserviciosnoa.com/:path*",
        "statusCode": 301
      }
    ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
