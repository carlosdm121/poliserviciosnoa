# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Desarrollo local. En producción usar una URL con pooling (Neon o Supabase).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/poliservicios?schema=public"

# ---------------------------------------------------------------------------
# Auth.js — el secret se genera con: openssl rand -base64 32
# ---------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Google OAuth (para el ingreso de clientes). Sin esto, el login por magic
# link sigue funcionando; Google es opcional en desarrollo.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Remitente de los emails de Auth.js (magic link, recuperación).
EMAIL_FROM="PoliserviciosNOA <no-reply@poliserviciosnoa.com>"

# Casilla que recibe los reclamos del libro de quejas. Tiene que ser una
# dirección que alguien lea: no es un alias de sistema.
CONTACT_EMAIL="contacto@poliserviciosnoa.com"

# ---------------------------------------------------------------------------
# Resend — emails transaccionales
# ---------------------------------------------------------------------------
RESEND_API_KEY=""

# ---------------------------------------------------------------------------
# Mercado Pago
# ---------------------------------------------------------------------------
# Credenciales de prueba (test-...) en desarrollo, reales (APP_USR-...) en
# producción. Nunca mezclar: un webhook de test recibido por credenciales
# reales queda con el perfil en PENDING para siempre.
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""

# Fuerza el proveedor real de Mercado Pago fuera de producción. Sin esto se usa
# el mock de src/lib/mp, que no abre ningún checkout ni toca la red. Misma regla
# que CLOUDINARY_REAL: la decisión es explícita y no inferida del token, para que
# un .env copiado de otra máquina no empiece a cobrar de verdad.
MP_REAL=""

# Monto de la suscripción mensual. Configurable para no hardcodearlo.
SUBSCRIPTION_AMOUNT="10000"
SUBSCRIPTION_CURRENCY="ARS"

# ---------------------------------------------------------------------------
# Facturación electrónica - ARCA (ex AFIP) vía Afip SDK
# ---------------------------------------------------------------------------
# El access token sale del panel de Afip SDK. Afip SDK gestiona el WSAA (Ticket
# de Acceso) solo: no hace falta certificado propio para empezar en dev.
ARCA_ACCESS_TOKEN=""
# "dev" usa el entorno de homologación; "prod" emite comprobantes reales.
ARCA_ENVIRONMENT="dev"
# CUIT del emisor, sin guiones.
ARCA_CUIT=""
ARCA_RAZON_SOCIAL="PoliserviciosNOA"
ARCA_PUNTO_VENTA="1"
# A | B | C. Con monotributo va C (IVA 0). Confirmar con el contador.
ARCA_TIPO_COMPROBANTE="C"
ARCA_CONDICION_IVA_EMISOR="RESPONSABLE_MONOTRIBUTO"
ARCA_ALICUOTA_IVA="21"
ARCA_DESCRIPCION="Suscripción mensual PoliserviciosNOA"
# Fuerza el proveedor real fuera de producción. Sin esto se usa el mock de
# src/lib/arca, que no emite comprobantes fiscales. Misma regla que MP_REAL.
ARCA_REAL=""
ARCA_MAX_ATTEMPTS="10"

# ---------------------------------------------------------------------------
# Cloudinary - galería de imágenes
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------------------------------------------------------------------------
# Upstash Redis — rate limiting
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# Hash de teléfonos y códigos
# ---------------------------------------------------------------------------
# Pepper del HMAC-SHA256 con el que se hashean teléfonos y códigos de
# verificación. Generalo una vez con: openssl rand -hex 32
#
# NO lo cambies después del primer perfil verificado: el hash del número queda
# atado a este valor y cambiarlo deja todos los perfiles sin poder verificar.
# Si se filtró, hay que rotarlo junto con una migración que rehashee todo.
PHONE_HASH_PEPPER=""

# ---------------------------------------------------------------------------
# Clave de cifrado de datos sensibles a nivel de aplicación
# ---------------------------------------------------------------------------
# Clave de 32 bytes en base64 para cifrar whatsappE164, datos fiscales (CUIT,
# DNI, domicilio fiscal) y cualquier dato personal sensible. Generalo una vez
# con: openssl rand -base64 32
#
# Sin esta clave, los datos cifrados en la base no se pueden descifrar aunque
# se filtre la base. NO la cambies sin hacer una migración que re-cifre todo.
DATA_ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Meta WhatsApp Cloud API — verificación del número
# ---------------------------------------------------------------------------
# Credenciales del número de la plataforma, no del profesional.
# El número va en E.164 sin signos: es el destino del mensaje de verificación.
WHATSAPP_PLATFORM_NUMBER="5491100000000"
WHATSAPP_PLATFORM_PHONE_ID=""
WHATSAPP_ACCESS_TOKEN=""
# Secreto de la app de Meta para validar X-Hub-Signature-256.
WHATSAPP_APP_SECRET=""
# Token del handshake. Es un string inventado por nosotros, no viene de Meta.
WHATSAPP_VERIFY_TOKEN=""

# Minutos de vida del código de verificación, antes de que el profesional
# tenga que pedir uno nuevo.
WHATSAPP_CODE_MINUTES="15"

# Intentos fallidos con un número ajeno antes de bloquear la verificación.
WHATSAPP_MAX_ATTEMPTS="5"

# ---------------------------------------------------------------------------
# Cloudflare Turnstile — protección contra bots (punto 12)
# ---------------------------------------------------------------------------
# Clave secreta del sitio para verificar tokens de Turnstile en el servidor.
# Obtener en https://dashboard.cloudflare.com/ (Turnstile).
TURNSTILE_SECRET=""

# ---------------------------------------------------------------------------
# Operaciones
# ---------------------------------------------------------------------------
# Vercel Cron lo manda como header Authorization: Bearer.
CRON_SECRET=""

# Hours que deben pasar desde el clic en WhatsApp hasta que el cliente puede
# votar. Configurable porque el tiempo de respuesta varía por rubro.
VOTE_MIN_HOURS_AFTER_CONTACT="24"

# Días de gracia tras un pago rechazado, antes de despublicar el perfil.
PAYMENT_GRACE_DAYS="2"

# Costo estimado del proveedor de email en USD, solo para el cálculo de
# margen en /admin. No afecta la lógica.
EMAIL_COST_USD="0.0003"